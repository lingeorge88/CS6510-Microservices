<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.selfcheckout</groupId>
    <artifactId>microservices</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>microservices</name>
    <description>Event-driven microservices implementation of the self-checkout API: four independently
        deployable services, each with its OWN database, communicating only through Kafka events.</description>

    <!--
      Four independently deployable microservices, each owning its own Postgres
      database. Services never share a database or call each other; all
      inter-service communication is asynchronous Kafka events. The only shared
      module is `events`, which carries the event CONTRACTS (JSON records + topic
      names) and the transactional-outbox plumbing. The cross-service `complete`
      flow is a choreographed saga (transaction-completed -> stock-shortfall).

      Build and start everything (fresh databases + topics):
        ./start.sh
      The load client targets the gateway: http://localhost:8080
    -->
    <properties>
        <java.version>21</java.version>
        <!-- No test suite in this project: skip compiling and running tests entirely. -->
        <maven.test.skip>true</maven.test.skip>
    </properties>

    <modules>
        <module>events</module>
        <module>catalog-service</module>
        <module>inventory-service</module>
        <module>checkout-service</module>
        <module>analytics-service</module>
    </modules>

</project>
